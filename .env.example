# 複製為 .env 並填入實際值（.env 不進 git）
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=metrics

# Airflow (T1.1) - AIRFLOW_ prefix, separate from warehouse POSTGRES_*
AIRFLOW_UID=50000
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_DB_NAME=airflow
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_JWT_SECRET=change-me-random-string
AIRFLOW_FERNET_KEY=
